{
  "version": 2,
  "builds": [
    {
      "src": "server.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.py"
    }
  ],
  "excludeFiles": [
    "app/**",
    "gradle/**",
    "assets/**",
    "selenium_tests/**",
    "mingit/**",
    "*.xlsx",
    "*.db",
    "*.gradle*",
    "gradlew*"
  ]
}
